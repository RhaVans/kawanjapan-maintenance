{
  "functions": {
    "api/page.js": {
      "includeFiles": "dist/index.html"
    }
  },
  "routes": [
    {
      "src": "^/assets/(.*)$",
      "headers": { "cache-control": "public, max-age=31536000, immutable" },
      "continue": true
    },
    { "src": "^/api/(.*)$", "continue": true },
    { "src": "^/(?!api/|assets/).*$", "dest": "/api/page" }
  ]
}
